{
  "profile": "amadeus",
  "version": "1.2.0",
  "name": "Amadeus GDS Profile",
  "commands": [
    {
      "code": "SN",
      "category": "Schedules",
      "name": "Schedule Neutral Display",
      "description": "Muestra los vuelos de la ruta (Comando SN + Fecha + IATA Origen + IATA Destino). Ej: SN 12 APR MEX SDQ.",
      "syntax": [
        "SN {date} {origin} {destination}",
        "SN{date}{origin}{destination}",
        "SN{date} {origin} {destination}"
      ],
      "tokens": {
        "date": "^(\\d{1,2}\\s?[A-Z]{3})",
        "origin": "\\s?([A-Z]{3})",
        "destination": "\\s?([A-Z]{3})"
      },
      "handler": "QUERY_SCHEDULE",
      "examples": [
        "SN 12 APR MEX SDQ",
        "SN13MARLIMCOP",
        "SN25NOVBOGMIA"
      ],
      "errors": {
        "INVALID_CITY": "CHECK CITY CODES"
      },
      "normalize": "compact"
    },
    {
      "code": "DAN",
      "category": "Encoding/Decoding",
      "name": "Encode City / Airport Name",
      "description": "Busca el código IATA de 3 letras a partir del nombre de una ciudad o aeropuerto.",
      "syntax": [
        "DAN {cityName}"
      ],
      "tokens": {
        "cityName": "^(.+)"
      },
      "handler": "ENCODE_CITY",
      "examples": [
        "DAN LIMA",
        "DAN BOGOTA",
        "DAN MADRID"
      ],
      "errors": {
        "NOT_FOUND": "NO MATCH FOR CITY NAME"
      }
    },
    {
      "code": "DAC",
      "category": "Encoding/Decoding",
      "name": "Decode IATA City / Airport Code",
      "description": "Decodifica el nombre completo de una ciudad y país a partir de su código IATA de 3 letras.",
      "syntax": [
        "DAC{cityCode}"
      ],
      "tokens": {
        "cityCode": "^([A-Z]{3})"
      },
      "handler": "DECODE_CITY",
      "examples": [
        "DAC LIM",
        "DAC BOG",
        "DAC MAD"
      ],
      "errors": {
        "INVALID_CODE": "CHECK IATA CITY CODE"
      },
      "normalize": "compact"
    },
    {
      "code": "FQC",
      "category": "Currency",
      "name": "Foreign Currency Conversion",
      "description": "Calcula la conversión entre divisas (ej: USD a COP) aplicando tasa BSR/IATA y gastos de gestión.",
      "syntax": [
        "FQC{amount}{fromCurrency}/{toCurrency}"
      ],
      "tokens": {
        "amount": "^(\\d+(?:\\.\\d+)?)",
        "fromCurrency": "^([A-Z]{3})/",
        "toCurrency": "^([A-Z]{3})"
      },
      "handler": "CONVERT_CURRENCY",
      "examples": [
        "FQC35USD/COP",
        "FQC100EUR/USD"
      ],
      "errors": {
        "INVALID_CURRENCY": "CHECK CURRENCY CODE"
      },
      "normalize": "compact"
    },
    {
      "code": "AN",
      "category": "Availability",
      "name": "Availability Display",
      "description": "Muestra vuelos disponibles y clases abiertas (Ej: AN25NOVBOGMIA).",
      "syntax": [
        "AN{date}{origin}{destination}",
        "AN {date} {origin} {destination}",
        "AN{date}{origin}{destination}/A{airline}"
      ],
      "tokens": {
        "date": "^(\\d{1,2}\\s?[A-Z]{3})",
        "origin": "\\s?([A-Z]{3})",
        "destination": "\\s?([A-Z]{3})",
        "airline": "(?:/A([A-Z0-9]{2}))?"
      },
      "handler": "QUERY_AVAILABILITY",
      "examples": [
        "AN25NOVBOGMIA",
        "AN 12 APR MEX SDQ"
      ],
      "errors": {
        "INVALID_CITY": "CHECK CITY CODES",
        "NO_FLIGHTS": "NO DIRECT FLIGHTS / CHECK DATES"
      },
      "normalize": "compact"
    },
    {
      "code": "SS",
      "category": "Booking",
      "name": "Sell Segment (Venta de Puestos)",
      "description": "Selecciona los puestos de los PAXS (SS + NRO_PASAJEROS + CLASE + NRO_VUELO). Ej: SS1Y1.",
      "syntax": [
        "SS{count}{class}{line}"
      ],
      "tokens": {
        "count": "^(\\d{1})",
        "class": "^([A-Z]{1})",
        "line": "^(\\d{1,2})"
      },
      "handler": "SELL_SEGMENT",
      "examples": [
        "SS1Y1",
        "SS2C3",
        "SS1J1"
      ],
      "errors": {
        "NO_AVAILABILITY": "CLASS CLOSED / NO SEATS AVAILABLE",
        "INVALID_LINE": "CHECK LINE NUMBER"
      },
      "normalize": "compact"
    },
    {
      "code": "NM",
      "category": "Passenger",
      "name": "Name Entry",
      "description": "Registra el nombre de los pasajeros (PAXS) en la reserva.",
      "syntax": [
        "NM1{surname}/{firstname} {title}",
        "NM{count}{surname}/{firstname1} {title1}/{firstname2} {title2}"
      ],
      "tokens": {
        "count": "^(\\d{1})?",
        "surname": "^([A-Z]+)/",
        "firstname": "^([A-Z]+)",
        "title": "(?: (MR|MRS|MS|MISS))?"
      },
      "handler": "ADD_NAME",
      "examples": [
        "NM1GARCIA/CARLOS MR",
        "NM2PEREZ/JUAN MR/MARIA MRS"
      ],
      "errors": {
        "INVALID_FORMAT": "FORMAT ERROR - NAME",
        "DUPLICATE_NAME": "CHECK PASSENGER NAME"
      }
    },
    {
      "code": "AP",
      "category": "Contact",
      "name": "Add Contact Phone",
      "description": "Agrega información de contacto telefónico del pasajero o agencia.",
      "syntax": [
        "AP{city} {phone}-{type}",
        "AP+{codigo pais y telefono}"
      ],
      "tokens": {
        "city": "^([A-Z]{3}) ",
        "phone": "^([0-9 +]+)-",
        "type": "^([A-Z]{1})"
      },
      "handler": "ADD_CONTACT",
      "examples": [
        "APBOG 573001234567-M",
        "AP+573001234567"
      ],
      "errors": {
        "INVALID_FORMAT": "FORMAT ERROR - PHONE"
      }
    },
    {
      "code": "TK",
      "category": "Ticketing",
      "name": "Ticketing Option",
      "description": "Define la opción o fecha límite para la emisión de tiquetes.",
      "syntax": [
        "TK OK",
        "TK TL{date}"
      ],
      "tokens": {
        "option": "^(OK|TL\\d{1,2}[A-Z]{3})"
      },
      "handler": "SET_TICKETING",
      "examples": [
        "TK OK",
        "TK TL25NOV"
      ],
      "errors": {
        "INVALID_FORMAT": "FORMAT ERROR - TK"
      },
      "normalize": "compact"
    },
    {
      "code": "RF",
      "category": "PNR Lifecycle",
      "name": "Received From (Recibido De)",
      "description": "RF = \"Recibido De\": registra QUIEN solicita la reserva o el cambio (el cliente o quien pide la gestion). Es un elemento OBLIGATORIO para poder cerrar y guardar el PNR con ER. Ej: RF CARLOS.",
      "syntax": [
        "RF {person}"
      ],
      "tokens": {
        "person": "^(.+)"
      },
      "handler": "SET_RECEIVED_FROM",
      "examples": [
        "RF CARLOS",
        "RF CLIENTE"
      ],
      "errors": {
        "MISSING_PARAM": "FORMAT ERROR - RECEIVED FROM"
      }
    },
    {
      "code": "ERK",
      "category": "PNR Lifecycle",
      "name": "End and Redisplay (Keep)",
      "description": "Guarda la reserva y la vuelve a mostrar, manteniendo el area de trabajo (variante de ER).",
      "syntax": [
        "ERK"
      ],
      "tokens": {},
      "handler": "END_AND_REDISPLAY",
      "examples": [
        "ERK"
      ],
      "errors": {}
    },
    {
      "code": "ER",
      "category": "PNR Lifecycle",
      "name": "End and Redisplay",
      "description": "Guarda la reserva actual (crea PNR) y la vuelve a mostrar en pantalla.",
      "syntax": [
        "ER"
      ],
      "tokens": {},
      "handler": "END_AND_REDISPLAY",
      "examples": [
        "ER"
      ],
      "errors": {
        "NEED_NAME": "NEED NAME",
        "NEED_ITINERARY": "NEED ITINERARY",
        "NEED_PHONE": "NEED PHONE ELEMENT",
        "NEED_TICKETING": "NEED TICKETING ELEMENT",
        "NEED_RF": "NEED RECEIVED FROM"
      }
    },
    {
      "code": "ET",
      "category": "PNR Lifecycle",
      "name": "End Transact",
      "description": "Guarda la reserva activa y limpia la pantalla del terminal.",
      "syntax": [
        "ET"
      ],
      "tokens": {},
      "handler": "END_TRANSACT",
      "examples": [
        "ET"
      ],
      "errors": {
        "NEED_PRINT": "CHECK MANDATORY PNR ELEMENTS (PRINT)"
      }
    },
    {
      "code": "IG",
      "category": "PNR Lifecycle",
      "name": "Ignore Transaction",
      "description": "Ignora las modificaciones no guardadas y limpia el área de trabajo.",
      "syntax": [
        "IG"
      ],
      "tokens": {},
      "handler": "IGNORE_TRANSACTION",
      "examples": [
        "IG"
      ],
      "errors": {}
    },
    {
      "code": "RT",
      "category": "PNR Display",
      "name": "Redisplay PNR",
      "description": "Vuelve a mostrar la reserva activa o abre un PNR guardado.",
      "syntax": [
        "RT",
        "RT{pnrCode}"
      ],
      "tokens": {
        "pnrCode": "^([A-Z0-9]{6})"
      },
      "handler": "REDISPLAY_PNR",
      "examples": [
        "RT",
        "RTK8X9P2"
      ],
      "errors": {
        "NOT_FOUND": "PNR NOT FOUND"
      },
      "normalize": "compact"
    },
    {
      "code": "XE",
      "category": "Cancelation",
      "name": "Cancel Element",
      "description": "Borra celdas de la reserva: una (XE1), un rango (XE1-3) o varias (XE4,8).",
      "syntax": [
        "XE{celda}",
        "XE{desde}-{hasta}",
        "XE{celda},{celda}"
      ],
      "tokens": {
        "lineNumber": "^([0-9,-]+)"
      },
      "handler": "CANCEL_ELEMENT",
      "examples": [
        "XE1",
        "XE1-3",
        "XE4,8"
      ],
      "errors": {
        "INVALID_LINE": "CHECK LINE NUMBER"
      },
      "normalize": "compact"
    },
    {
      "code": "XI",
      "category": "Cancelation",
      "name": "Cancel Itinerary",
      "description": "Cancela todos los segmentos de vuelo de la reserva activa.",
      "syntax": [
        "XI"
      ],
      "tokens": {},
      "handler": "CANCEL_ITINERARY",
      "examples": [
        "XI"
      ],
      "errors": {
        "NO_ITINERARY": "NO ITINERARY TO CANCEL"
      }
    },
    {
      "code": "FXX",
      "category": "Pricing",
      "name": "Facturar Precio del Vuelo (Informativo)",
      "description": "Factura la tarifa para cada pasajero (Adulto, Child 'Niño' o Infante) según cabina. Ej: FXX/FF-BASIC/RAD*CH*IN,BOG.",
      "syntax": [
        "FXX",
        "FXX/FF-{fareFamily}",
        "FXX/R,{modifier}",
        "FXX/{params}"
      ],
      "tokens": {
        "params": "^(.+)"
      },
      "handler": "PRICE_INFORMATIVE",
      "examples": [
        "FXX",
        "FXX/FF-OPTIMA/RAD*CH*IN,BOG",
        "FXX/R,CH"
      ],
      "errors": {
        "NO_ITINERARY": "NO ITINERARY TO PRICE"
      }
    },
    {
      "code": "FXP",
      "category": "Pricing",
      "name": "Facturar Precio y Crear Registro TST",
      "description": "Factura la tarifa para cada pasajero y crea el registro de tarifa (TST) para emisión. Ej: FXP/FF-OPTIMA/RAD*CH*IN,BOG.",
      "syntax": [
        "FXP",
        "FXP/FF-{fareFamily}",
        "FXP/R,{modifier}",
        "FXP/{params}"
      ],
      "tokens": {
        "params": "^(.+)"
      },
      "handler": "PRICE_AND_STORE",
      "examples": [
        "FXP",
        "FXP/FF-OPTIMA/RAD*CH*IN,BOG",
        "FXP/R,CH"
      ],
      "errors": {
        "NO_ITINERARY": "NO ITINERARY TO PRICE",
        "NO_NAMES": "NEED PASSENGER NAME"
      }
    },
    {
      "code": "HE",
      "category": "Help",
      "name": "Help & Syntax Manual",
      "description": "Muestra la ayuda y sintaxis declarada para los comandos GDS.",
      "syntax": [
        "HE",
        "HE {topic}"
      ],
      "tokens": {
        "topic": "^([A-Z0-9]+)"
      },
      "handler": "SHOW_HELP",
      "examples": [
        "HE",
        "HE AN",
        "HE NM",
        "HE SN",
        "HE SS",
        "HE FXX"
      ],
      "errors": {}
    },
    {
      "code": "SR",
      "category": "Services",
      "name": "Special Service Request (SSR)",
      "description": "Solicitudes especiales y contactos de seguridad: comidas (VGML), sillas (WCHR), correo (CTCE- con // en vez de @) y telefono (CTCM-).",
      "syntax": [
        "SR {code}"
      ],
      "tokens": {
        "code": "^([A-Z]{2,4})"
      },
      "handler": "ADD_SSR",
      "examples": [
        "SR VGML",
        "SR WCHR",
        "SR CTCE-JUAN//GMAIL.COM",
        "SR CTCM-573001234567"
      ],
      "errors": {
        "INVALID_CODE": "CHECK SERVICE CODE"
      }
    },
    {
      "code": "OS",
      "category": "Services",
      "name": "Other Service Info (OSI)",
      "description": "Agrega información de servicio no accionable para las aerolíneas.",
      "syntax": [
        "OS {airline} {text}"
      ],
      "tokens": {
        "airline": "^([A-Z0-9]{2}) ",
        "text": "^(.+)"
      },
      "handler": "ADD_OSI",
      "examples": [
        "OS AV PASAJERO VIP",
        "OS YY HFBB"
      ],
      "errors": {}
    },
    {
      "code": "TTP",
      "category": "Ticketing",
      "name": "Issue Ticket",
      "description": "Simula la emisión del tiquete electrónico para reservas con TST.",
      "syntax": [
        "TTP",
        "TTP1(?:/{modifier})?"
      ],
      "tokens": {
        "modifier": "^(.*)"
      },
      "handler": "ISSUE_TICKET",
      "examples": [
        "TTP",
        "TTP1/ET/RT"
      ],
      "errors": {
        "NO_TST": "NO TST PRESENT FOR ISSUANCE",
        "NEED_OK": "CHECK TICKETING ELEMENT"
      }
    },
    {
      "code": "FP",
      "category": "Ticketing",
      "name": "Form of Payment",
      "description": "Ingresa la forma de pago (ej. FP CASH,).",
      "syntax": [
        "FP {fop}"
      ],
      "tokens": {
        "fop": "^([A-Za-z,\\s]+)"
      },
      "handler": "ADD_FOP",
      "examples": [
        "FP CASH",
        "FP CASH,"
      ],
      "errors": {}
    },
    {
      "code": "TTO",
      "category": "Ticketing",
      "name": "Ticketing Override / Fee",
      "description": "Ingresa gastos de gestión y override de ticketing (ej. TTO/ST01/CSF/F35/T1).",
      "syntax": [
        "TTO/{params}"
      ],
      "tokens": {
        "params": "^(.*)"
      },
      "handler": "ADD_TTO",
      "examples": [
        "TTO/ST01/CSF/F35/T1"
      ],
      "errors": {}
    },
    {
      "code": "SO",
      "category": "System",
      "name": "Sign Out",
      "description": "Cierra la sesión activa en el terminal.",
      "syntax": [
        "SO"
      ],
      "tokens": {},
      "handler": "SIGN_OUT",
      "examples": [
        "SO"
      ],
      "errors": {}
    },
    {
      "code": "DF",
      "category": "Pricing",
      "name": "Detailed Fare Summation / Diferencia de Tarifa",
      "description": "Tres modos según el contexto: (1) suma DF VALOR1;VALOR2;GASTOS*CANTIDAD_PAX. (2) diferencia de tarifa DF nueva-original (cotización nueva menos ticket original). (3) penalidad menos descuento DF penalidad P descuento.",
      "syntax": [
        "DF {expression}",
        "DF {nueva}-{original}",
        "DF {penalidad}P{descuento}"
      ],
      "tokens": {
        "expression": "^(.+)"
      },
      "handler": "SUM_FARES",
      "examples": [
        "DF 2*200000;1000000;860000;240000*3",
        "DF 500000;250000;100000*2",
        "DF 1890 - 1750",
        "DF 150 P 75"
      ],
      "errors": {
        "FORMAT_ERROR": "FORMAT ERROR - DF EXPRESSION"
      }
    },
    {
      "code": "RM",
      "category": "Remarks",
      "name": "General Remark / Notes",
      "description": "Registra notas explicativas, desgloses de tarifa y políticas de reembolso en la reserva.",
      "syntax": [
        "RM {text}",
        "RM*{date}*{text}"
      ],
      "tokens": {
        "text": "^(.+)"
      },
      "handler": "ADD_REMARK",
      "examples": [
        "RM *22JUL26* ADT 2200000, CHD 1000000, INF 860000, GG 240000 COP",
        "RM *22JUL26* TTL 12900000 COP"
      ],
      "errors": {
        "FORMAT_ERROR": "FORMAT ERROR - REMARK"
      }
    },
    {
      "code": "FQN",
      "category": "Pricing",
      "name": "Fare Components / Penalidades del Ticket",
      "description": "Muestra las condiciones del ticket (reembolsos en CANCELLATIONS, cambios en CHANGES). Ej: FQN1*PE. Navega con MD/MU.",
      "syntax": [
        "FQN{nroTicket}*PE"
      ],
      "tokens": {
        "ticket": "^(d{1,2})",
        "pe": "(?:[*](PE))?"
      },
      "handler": "SHOW_FARE_RULES",
      "examples": [
        "FQN1*PE"
      ],
      "normalize": "compact",
      "errors": {
        "NO_TICKET": "NO FARE COMPONENTS - CHECK TICKET NUMBER"
      }
    },
