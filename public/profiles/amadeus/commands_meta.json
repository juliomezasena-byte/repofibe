{
  "profile": "amadeus",
  "version": "1.2.0",
  "name": "Amadeus GDS Profile",
  "commands": [
    {
      "code": "SN",
      "category": "Schedules",
      "name": "Schedule Neutral Display",
      "description": "Muestra los vuelos de la ruta (Comando SN + Fecha + IATA Origen + IATA Destino). Ej: SN 12 APR MEX SDQ.",
      "syntax": [
        "SN {date} {origin} {destination}",
        "SN{date}{origin}{destination}",
        "SN{date} {origin} {destination}"
      ],
      "tokens": {
        "date": "^(\\d{1,2}\\s?[A-Z]{3})",
        "origin": "\\s?([A-Z]{3})",
        "destination": "\\s?([A-Z]{3})"
      },
      "handler": "QUERY_SCHEDULE",
      "examples": [
        "SN 12 APR MEX SDQ",
        "SN13MARLIMCOP",
        "SN25NOVBOGMIA"
      ],
      "errors": {
        "INVALID_CITY": "CHECK CITY CODES"
      },
      "normalize": "compact"
    },
    {
      "code": "DAN",
      "category": "Encoding/Decoding",
      "name": "Encode City / Airport Name",
      "description": "Busca el código IATA de 3 letras a partir del nombre de una ciudad o aeropuerto.",
      "syntax": [
        "DAN {cityName}"
      ],
      "tokens": {
        "cityName": "^(.+)"
      },
      "handler": "ENCODE_CITY",
      "examples": [
        "DAN LIMA",
        "DAN BOGOTA",
        "DAN MADRID"
      ],
      "errors": {
        "NOT_FOUND": "NO MATCH FOR CITY NAME"
      }
    },
    {
      "code": "DAC",
      "category": "Encoding/Decoding",
      "name": "Decode IATA City / Airport Code",
      "description": "Decodifica el nombre completo de una ciudad y país a partir de su código IATA de 3 letras.",
      "syntax": [
        "DAC{cityCode}"
      ],
      "tokens": {
        "cityCode": "^([A-Z]{3})"
      },
      "handler": "DECODE_CITY",
      "examples": [
        "DAC LIM",
        "DAC BOG",
        "DAC MAD"
      ],
      "errors": {
        "INVALID_CODE": "CHECK IATA CITY CODE"
      },
      "normalize": "compact"
    },
    {
      "code": "FQC",
      "category": "Currency",
      "name": "Foreign Currency Conversion",
      "description": "Calcula la conversión entre divisas (ej: USD a COP) aplicando tasa BSR/IATA y gastos de gestión.",
      "syntax": [
        "FQC{amount}{fromCurrency}/{toCurrency}"
      ],
      "tokens": {
        "amount": "^(\\d+(?:\\.\\d+)?)",
        "fromCurrency": "^([A-Z]{3})/",
        "toCurrency": "^([A-Z]{3})"
      },
      "handler": "CONVERT_CURRENCY",
      "examples": [
        "FQC35USD/COP",
        "FQC100EUR/USD"
      ],
      "errors": {
        "INVALID_CURRENCY": "CHECK CURRENCY CODE"
      },
      "normalize": "compact"
    },
    {
      "code": "AN",
      "category": "Availability",
      "name": "Availability Display",
      "description": "Muestra vuelos disponibles y clases abiertas (Ej: AN25NOVBOGMIA).",
      "syntax": [
        "AN{date}{origin}{destination}",
        "AN {date} {origin} {destination}",
        "AN{date}{origin}{destination}/A{airline}"
      ],
      "tokens": {
        "date": "^(\\d{1,2}\\s?[A-Z]{3})",
        "origin": "\\s?([A-Z]{3})",
        "destination": "\\s?([A-Z]{3})",
        "airline": "(?:/A([A-Z0-9]{2}))?"
      },
      "handler": "QUERY_AVAILABILITY",
      "examples": [
        "AN25NOVBOGMIA",
        "AN 12 APR MEX SDQ"
      ],
      "errors": {
        "INVALID_CITY": "CHECK CITY CODES",
        "NO_FLIGHTS": "NO DIRECT FLIGHTS / CHECK DATES"
      },
      "normalize": "compact"
    },
    {
      "code": "SS",
      "category": "Booking",
      "name": "Sell Segment (Venta de Puestos)",
      "description": "Selecciona los puestos de los PAXS (SS + NRO_PASAJEROS + CLASE + NRO_VUELO). Ej: SS1Y1.",
      "syntax": [
        "SS{count}{class}{line}"
      ],
      "tokens": {
        "count": "^(\\d{1})",
        "class": "^([A-Z]{1})",
        "line": "^(\\d{1,2})"
      },
      "handler": "SELL_SEGMENT",
      "examples": [
        "SS1Y1",
        "SS2C3",
        "SS1J1"
      ],
      "errors": {
        "NO_AVAILABILITY": "CLASS CLOSED / NO SEATS AVAILABLE",
        "INVALID_LINE": "CHECK LINE NUMBER"
      },
      "normalize": "compact"
    },
    {
      "code": "NM",
      "category": "Passenger",
      "name": "Name Entry",
      "description": "Registra el nombre de los pasajeros (PAXS) en la reserva.",
      "syntax": [
        "NM1{surname}/{firstname} {title}",
        "NM{count}{surname}/{firstname1} {title1}/{firstname2} {title2}"
      ],
      "tokens": {
        "count": "^(\\d{1})?",
        "surname": "^([A-Z]+)/",
        "firstname": "^([A-Z]+)",
        "title": "(?: (MR|MRS|MS|MISS))?"
      },
      "handler": "ADD_NAME",
      "examples": [
        "NM1GARCIA/CARLOS MR",
        "NM2PEREZ/JUAN MR/MARIA MRS"
      ],
      "errors": {
        "INVALID_FORMAT": "FORMAT ERROR - NAME",
        "DUPLICATE_NAME": "CHECK PASSENGER NAME"
      }
    },
    {
      "code": "AP",
      "category": "Contact",
      "name": "Add Contact Phone",
      "description": "Agrega información de contacto telefónico del pasajero o agencia.",
      "syntax": [
        "AP{city} {phone}-{type}",
        "AP+{codigo pais y telefono}"
      ],
      "tokens": {
        "city": "^([A-Z]{3}) ",
        "phone": "^([0-9 +]+)-",
        "type": "^([A-Z]{1})"
      },
      "handler": "ADD_CONTACT",
      "examples": [
        "APBOG 573001234567-M",
        "AP+573001234567"
      ],
      "errors": {
        "INVALID_FORMAT": "FORMAT ERROR - PHONE"
      }
    },
    {
      "code": "TK",
      "category": "Ticketing",
      "name": "Ticketing Option",
      "description": "Define la opción o fecha límite para la emisión de tiquetes.",
      "syntax": [
        "TK OK",
        "TK TL{date}"
      ],
      "tokens": {
        "option": "^(OK|TL\\d{1,2}[A-Z]{3})"
      },
      "handler": "SET_TICKETING",
      "examples": [
        "TK OK",
        "TK TL25NOV"
      ],
      "errors": {
        "INVALID_FORMAT": "FORMAT ERROR - TK"
      },
      "normalize": "compact"
    },
    {
      "code": "RF",
      "category": "PNR Lifecycle",
      "name": "Received From",
      "description": "Registra la persona que solicita la transacción o modificación del PNR.",
      "syntax": [
        "RF {person}"
      ],
      "tokens": {
        "person": "^(.+)"
      },
      "handler": "SET_RECEIVED_FROM",
      "examples": [
        "RF CARLOS",
        "RF CLIENTE"
      ],
      "errors": {
        "MISSING_PARAM": "FORMAT ERROR - RECEIVED FROM"
      }
    },
    {
      "code": "ER",
      "category": "PNR Lifecycle",
      "name": "End and Redisplay",
      "description": "Guarda la reserva actual (crea PNR) y la vuelve a mostrar en pantalla.",
      "syntax": [
        "ER"
      ],
      "tokens": {},
      "handler": "END_AND_REDISPLAY",
      "examples": [
        "ER"
      ],
      "errors": {
        "NEED_NAME": "NEED NAME",
        "NEED_ITINERARY": "NEED ITINERARY",
        "NEED_PHONE": "NEED PHONE ELEMENT",
        "NEED_TICKETING": "NEED TICKETING ELEMENT",
        "NEED_RF": "NEED RECEIVED FROM"
      }
    },
    {
      "code": "ET",
      "category": "PNR Lifecycle",
      "name": "End Transact",
      "description": "Guarda la reserva activa y limpia la pantalla del terminal.",
      "syntax": [
        "ET"
      ],
      "tokens": {},
      "handler": "END_TRANSACT",
      "examples": [
        "ET"
      ],
      "errors": {
        "NEED_PRINT": "CHECK MANDATORY PNR ELEMENTS (PRINT)"
      }
    },
    {
      "code": "IG",
      "category": "PNR Lifecycle",
      "name": "Ignore Transaction",
      "description": "Ignora las modificaciones no guardadas y limpia el área de trabajo.",
      "syntax": [
        "IG"
      ],
      "tokens": {},
      "handler": "IGNORE_TRANSACTION",
      "examples": [
        "IG"
      ],
      "errors": {}
    },
    {
      "code": "RT",
      "category": "PNR Display",
      "name": "Redisplay PNR",
      "description": "Vuelve a mostrar la reserva activa o abre un PNR guardado.",
      "syntax": [
        "RT",
        "RT{pnrCode}"
      ],
      "tokens": {
        "pnrCode": "^([A-Z0-9]{6})"
      },
      "handler": "REDISPLAY_PNR",
      "examples": [
        "RT",
        "RTK8X9P2"
      ],
      "errors": {
        "NOT_FOUND": "PNR NOT FOUND"
      },
      "normalize": "compact"
    },
    {
      "code": "XE",
      "category": "Cancelation",
      "name": "Cancel Element",
      "description": "Borra celdas de la reserva: una (XE1), un rango (XE1-3) o varias (XE4,8).",
      "syntax": [
        "XE{celda}",
        "XE{desde}-{hasta}",
        "XE{celda},{celda}"
      ],
      "tokens": {
        "lineNumber": "^([0-9,-]+)"
      },
      "handler": "CANCEL_ELEMENT",
      "examples": [
        "XE1",
        "XE1-3",
        "XE4,8"
      ],
      "errors": {
        "INVALID_LINE": "CHECK LINE NUMBER"
      },
      "normalize": "compact"
    },
    {
      "code": "XI",
      "category": "Cancelation",
      "name": "Cancel Itinerary",
      "description": "Cancela todos los segmentos de vuelo de la reserva activa.",
      "syntax": [
        "XI"
      ],
      "tokens": {},
      "handler": "CANCEL_ITINERARY",
      "examples": [
        "XI"
      ],
      "errors": {
        "NO_ITINERARY": "NO ITINERARY TO CANCEL"
      }
    },
    {
      "code": "FXX",
      "category": "Pricing",
      "name": "Facturar Precio del Vuelo (Informativo)",
      "description": "Factura la tarifa para cada pasajero (Adulto, Child 'Niño' o Infante) según cabina. Ej: FXX/FF-BASIC/RAD*CH*IN,BOG.",
      "syntax": [
        "FXX",
        "FXX/FF-{fareFamily}",
        "FXX/R,{modifier}",
        "FXX/{params}"
      ],
      "tokens": {
        "params": "^(.+)"
      },
      "handler": "PRICE_INFORMATIVE",
      "examples": [
        "FXX",
        "FXX/FF-OPTIMA/RAD*CH*IN,BOG",
        "FXX/R,CH"
      ],
      "errors": {
        "NO_ITINERARY": "NO ITINERARY TO PRICE"
      }
    },
    {
      "code": "FXP",
      "category": "Pricing",
      "name": "Facturar Precio y Crear Registro TST",
      "description": "Factura la tarifa para cada pasajero y crea el registro de tarifa (TST) para emisión. Ej: FXP/FF-OPTIMA/RAD*CH*IN,BOG.",
      "syntax": [
        "FXP",
        "FXP/FF-{fareFamily}",
        "FXP/R,{modifier}",
        "FXP/{params}"
      ],
      "tokens": {
        "params": "^(.+)"
      },
      "handler": "PRICE_AND_STORE",
      "examples": [
        "FXP",
        "FXP/FF-OPTIMA/RAD*CH*IN,BOG",
        "FXP/R,CH"
      ],
      "errors": {
        "NO_ITINERARY": "NO ITINERARY TO PRICE",
        "NO_NAMES": "NEED PASSENGER NAME"
      }
    },
    {
      "code": "HE",
      "category": "Help",
      "name": "Help & Syntax Manual",
      "description": "Muestra la ayuda y sintaxis declarada para los comandos GDS.",
      "syntax": [
        "HE",
        "HE {topic}"
      ],
      "tokens": {
        "topic": "^([A-Z0-9]+)"
      },
      "handler": "SHOW_HELP",
      "examples": [
        "HE",
        "HE AN",
        "HE NM",
        "HE SN",
        "HE SS",
        "HE FXX"
      ],
      "errors": {}
    },
    {
      "code": "SR",
      "category": "Services",
      "name": "Special Service Request (SSR)",
      "description": "Solicitudes especiales y contactos de seguridad: comidas (VGML), sillas (WCHR), correo (CTCE- con // en vez de @) y telefono (CTCM-).",
      "syntax": [
        "SR {code}"
      ],
      "tokens": {
        "code": "^([A-Z]{2,4})"
      },
      "handler": "ADD_SSR",
      "examples": [
        "SR VGML",
        "SR WCHR",
        "SR CTCE-JUAN//GMAIL.COM",
        "SR CTCM-573001234567"
      ],
      "errors": {
        "INVALID_CODE": "CHECK SERVICE CODE"
      }
    },
    {
      "code": "OS",
      "category": "Services",
      "name": "Other Service Info (OSI)",
      "description": "Agrega información de servicio no accionable para las aerolíneas.",
      "syntax": [
        "OS {airline} {text}"
      ],
      "tokens": {
        "airline": "^([A-Z0-9]{2}) ",
        "text": "^(.+)"
      },
      "handler": "ADD_OSI",
      "examples": [
        "OS AV PASAJERO VIP",
        "OS YY HFBB"
      ],
      "errors": {}
    },
    {
      "code": "TTP",
      "category": "Ticketing",
      "name": "Issue Ticket",
      "description": "Simula la emisión del tiquete electrónico para reservas con TST.",
      "syntax": [
        "TTP"
      ],
      "tokens": {},
      "handler": "ISSUE_TICKET",
      "examples": [
        "TTP"
      ],
      "errors": {
        "NO_TST": "NO TST PRESENT FOR ISSUANCE",
        "NEED_OK": "CHECK TICKETING ELEMENT"
      }
    },
    {
      "code": "SO",
      "category": "System",
      "name": "Sign Out",
      "description": "Cierra la sesión activa en el terminal.",
      "syntax": [
        "SO"
      ],
      "tokens": {},
      "handler": "SIGN_OUT",
      "examples": [
        "SO"
      ],
      "errors": {}
    },
    {
      "code": "DF",
      "category": "Pricing",
      "name": "Detailed Fare Summation",
      "description": "Calcula la suma total de las tarifas de los pasajeros más los gastos de gestión (DF VALOR1;VALOR2;GASTOS*CANTIDAD_PAX).",
      "syntax": [
        "DF {expression}"
      ],
      "tokens": {
        "expression": "^(.+)"
      },
      "handler": "SUM_FARES",
      "examples": [
        "DF 2*200000;1000000;860000;240000*3",
        "DF 500000;250000;100000*2"
      ],
      "errors": {
        "FORMAT_ERROR": "FORMAT ERROR - DF EXPRESSION"
      }
    },
    {
      "code": "RM",
      "category": "Remarks",
      "name": "General Remark / Notes",
      "description": "Registra notas explicativas, desgloses de tarifa y políticas de reembolso en la reserva.",
      "syntax": [
        "RM {text}",
        "RM*{date}*{text}"
      ],
      "tokens": {
        "text": "^(.+)"
      },
      "handler": "ADD_REMARK",
      "examples": [
        "RM *22JUL26* ADT 2200000, CHD 1000000, INF 860000, GG 240000 COP",
        "RM *22JUL26* TTL 12900000 COP"
      ],
      "errors": {
        "FORMAT_ERROR": "FORMAT ERROR - REMARK"
      }
    },
    {
      "code": "FQN",
      "category": "Pricing",
      "name": "Fare Components / Penalidades del Ticket",
      "description": "Muestra las condiciones del ticket (reembolsos en CANCELLATIONS, cambios en CHANGES). Ej: FQN1*PE. Navega con MD/MU.",
      "syntax": [
        "FQN{nroTicket}*PE"
      ],
      "tokens": {
        "ticket": "^(d{1,2})",
        "pe": "(?:[*](PE))?"
      },
      "handler": "SHOW_FARE_RULES",
      "examples": [
        "FQN1*PE"
      ],
      "normalize": "compact",
      "errors": {
        "NO_TICKET": "NO FARE COMPONENTS - CHECK TICKET NUMBER"
      }
    },
    {
      "code": "MN",
      "category": "Schedules",
      "name": "Dia Siguiente",
      "description": "Se mueve al dia siguiente en el itinerario de vuelos mostrado (SN/AN).",
      "syntax": [
        "MN"
      ],
      "tokens": {},
      "handler": "MOVE_NEXT_DAY",
      "examples": [
        "MN"
      ],
      "errors": {
        "NO_DISPLAY": "NO DISPLAY - RUN SN/AN FIRST"
      }
    },
    {
      "code": "MY",
      "category": "Schedules",
      "name": "Dia Anterior",
      "description": "Se mueve al dia anterior en el itinerario de vuelos mostrado (SN/AN).",
      "syntax": [
        "MY"
      ],
      "tokens": {},
      "handler": "MOVE_PREV_DAY",
      "examples": [
        "MY"
      ],
      "errors": {
        "NO_DISPLAY": "NO DISPLAY - RUN SN/AN FIRST"
      }
    },
    {
      "code": "MO",
      "category": "Schedules",
      "name": "Dia Original",
      "description": "Vuelve al dia original del itinerario de vuelos mostrado (SN/AN).",
      "syntax": [
        "MO"
      ],
      "tokens": {},
      "handler": "MOVE_ORIG_DAY",
      "examples": [
        "MO"
      ],
      "errors": {
        "NO_DISPLAY": "NO DISPLAY - RUN SN/AN FIRST"
      }
    },
    {
      "code": "MD",
      "category": "System",
      "name": "Pagina Siguiente",
      "description": "Avanza a la pagina siguiente en pantallas largas (FQN, FXX).",
      "syntax": [
        "MD"
      ],
      "tokens": {},
      "handler": "PAGE_DOWN",
      "examples": [
        "MD"
      ],
      "errors": {
        "NO_PAGES": "NO MORE PAGES"
      }
    },
    {
      "code": "MU",
      "category": "System",
      "name": "Pagina Anterior",
      "description": "Retrocede a la pagina anterior en pantallas largas (FQN, FXX).",
      "syntax": [
        "MU"
      ],
      "tokens": {},
      "handler": "PAGE_UP",
      "examples": [
        "MU"
      ],
      "errors": {
        "NO_PAGES": "ALREADY ON FIRST PAGE"
      }
    },
    {
      "code": "TKXL",
      "category": "Ticketing",
      "name": "Plazo de Confirmacion (Time Limit)",
      "description": "Fija el plazo de confirmacion de la cita/reserva, normalmente 24 hrs despues. Ej: TKXL 24JUL.",
      "syntax": [
        "TKXL{date}"
      ],
      "tokens": {
        "date": "^(d{1,2}[A-Z]{3})"
      },
      "handler": "SET_TICKETING",
      "examples": [
        "TKXL 24JUL",
        "TKXL24JUL"
      ],
      "normalize": "compact",
      "errors": {
        "INVALID_FORMAT": "FORMAT ERROR - TKXL"
      }
    },
    {
      "code": "APE",
      "category": "Contact",
      "name": "Correo de Confirmacion",
      "description": "Agrega el correo electronico de confirmacion del pasajero (con @).",
      "syntax": [
        "APE-{correo}"
      ],
      "tokens": {
        "email": "^-(.+)"
      },
      "handler": "ADD_CONTACT",
      "examples": [
        "APE-JUAN@GMAIL.COM"
      ],
      "errors": {
        "INVALID_FORMAT": "FORMAT ERROR - EMAIL"
      }
    },
    {
      "code": "SRXBAG",
      "category": "Services",
      "name": "Servicio de Equipaje Extra (SSR XBAG)",
      "description": "Solicita equipaje adicional para un pasajero en un segmento (SRXBAG/P{pax}/S{segmento}). Ej: SRXBAG/P1/S2.",
      "syntax": [
        "SRXBAG/P{pax}/S{segmento}"
      ],
      "tokens": {},
      "handler": "ADD_BAGGAGE",
      "examples": [
        "SRXBAG/P1/S2",
        "SRXBAG/P1/S1"
      ],
      "errors": {
        "FORMAT_ERROR": "FORMAT ERROR - CHECK /P PAX /S SEGMENT"
      }
    },
    {
      "code": "FXG",
      "category": "Services",
      "name": "Guardar Servicio de Equipaje (crear TSM)",
      "description": "Guarda el servicio de equipaje y crea el registro TSM (documento del servicio) para su emision.",
      "syntax": [
        "FXG"
      ],
      "tokens": {},
      "handler": "SAVE_BAGGAGE",
      "examples": [
        "FXG"
      ],
      "errors": {
        "NO_BAGGAGE": "NO BAGGAGE SERVICE TO STORE"
      }
    },
    {
      "code": "TQM",
      "category": "Ticketing",
      "name": "Ver TSM y Entrar a Forma de Pago",
      "description": "Muestra el TSM del servicio y abre el registro para agregar la forma de pago.",
      "syntax": [
        "TQM"
      ],
      "tokens": {},
      "handler": "SHOW_TSM",
      "examples": [
        "TQM"
      ],
      "errors": {
        "NO_TSM": "NO TSM PRESENT - USE FXG FIRST"
      }
    },
    {
      "code": "TMI",
      "category": "Ticketing",
      "name": "Forma de Pago del Servicio (TMI/FP-)",
      "description": "Agrega la forma de pago al TSM del servicio. Ej: TMI/FP-CASH,",
      "syntax": [
        "TMI/FP-{forma}"
      ],
      "tokens": {},
      "handler": "SET_FOP",
      "examples": [
        "TMI/FP-CASH,",
        "TMI/FP-CASH"
      ],
      "errors": {
        "FORMAT_ERROR": "FORMAT ERROR - TMI/FP-"
      }
    },
    {
      "code": "TTM",
      "category": "Ticketing",
      "name": "Emitir EMD del Servicio (TTM/M{n}/RT)",
      "description": "Emite el documento electronico del servicio de equipaje (EMD) a partir del TSM. Ej: TTM/M1/RT.",
      "syntax": [
        "TTM/M{nroTsm}/RT"
      ],
      "tokens": {},
      "handler": "ISSUE_TSM",
      "examples": [
        "TTM/M1/RT"
      ],
      "errors": {
        "NO_TSM": "NO TSM TO ISSUE",
        "NEED_FOP": "NEED FORM OF PAYMENT (TMI/FP-)"
      }
    }
  ]
}
