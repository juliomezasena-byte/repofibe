    { "n": 3, "sistema": "amadeus", "proceso": "Agregar dirección de destino", "comando": "SR DOCA YY HK1-D-{paisDestino}-{direccion}-{ciudad}-{iataCiudad}-{codigoPostal}/P{pasajero}", "explicacion": "D = dirección de destino.", "confianza": "verbatim", "condicional": "requerido-por-itinerario" },
    { "n": 4, "sistema": "amadeus", "proceso": "Agregar país de residencia", "comando": "SR DOCA YY HK1-R-{paisResidencia}/P{pasajero}", "explicacion": "R = país de residencia actual.", "confianza": "verbatim", "condicional": "requerido-por-itinerario" },
    { "n": 5, "sistema": "amadeus", "proceso": "Agregar visa o redress", "comando": "SR DOCO YY HK1-{ciudadNacimiento} {paisNacimiento}-{tipoDocumento}-{numeroDocumento}-{ciudadExpedicion} {paisExpedicion}-{fechaExpedicion}-{paisDestino}-{indicadorInfante}-{fechaExpiracion}/P{pasajero}", "explicacion": "Tipo V = Visa, R = Redress, K = Known Traveller. El indicador I se usa solo para INF según el ejemplo.", "confianza": "verbatim", "condicional": "visa-redress" },
