    { "n": 1, "sistema": "amadeus", "proceso": "Agregar pasaporte de ADT o CHD", "comando": "SR DOCS YY HK1-P-{paisDocumento}-{numeroDocumento}-{paisNacimiento}-{fechaNacimiento}-{genero}-{fechaCaducidad}-{apellido}/{nombre}/P{pasajero}", "explicacion": "P = pasaporte; género ADT/CHD M o F; asociar al pasajero P#.", "confianza": "verbatim", "esBloqueante": true },
