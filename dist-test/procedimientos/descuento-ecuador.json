    { "n": 11, "sistema": "amadeus", "proceso": "Guardar tarifa descuento discapacidad", "comando": null, "plantilla": "FXP/FF-{tarifa}/RDIS", "explicacion": "FXP con RDIS.", "confianza": "verbatim" },
    { "n": 11.1, "sistema": "amadeus", "proceso": "Guardar tarifa descuento joven", "comando": null, "plantilla": "FXP/FF-{tarifa}/RZZ", "explicacion": "FXP con RZZ.", "confianza": "verbatim" },
    { "n": 11.2, "sistema": "amadeus", "proceso": "Guardar tarifa adulto mayor", "comando": null, "plantilla": "FXP/FF-{tarifa}/RCD", "explicacion": "FXP con RCD.", "confianza": "verbatim" },
    { "n": 11.3, "sistema": "amadeus", "proceso": "Seleccionar opciones de tarifa", "comando": null, "plantilla": "FXT{opcion}/P{pasajero}", "explicacion": "Para varias opciones: FXT05/P1//06/P2.", "confianza": "verbatim" },
    { "n": 12, "sistema": "amadeus", "proceso": "Verificar mascara TST", "comando": "TQT", "variantes": ["TQT/T1"], "explicacion": "TQT para un tipo de pasajero; TQT/T1 para varios. Guardar con ER.", "confianza": "verbatim" },
    { "n": 13, "sistema": "amadeus", "proceso": "Agregar DOCS obligatorio", "comando": null, "plantilla": "SR DOCS YY HK1-P-{paisDocumento}-{numeroDocumento}-{paisNacimiento}-{fechaNacimiento}-{genero}-{caducidadDocumento}-{apellido}/{nombre}/P{pasajero}", "explicacion": "DOCS es obligatorio y valida la documentacion del pasajero. Guardar con ER.", "confianza": "verbatim", "esBloqueante": true },
    { "n": 14, "sistema": "amadeus", "proceso": "Enviar itinerario - ON HOLD por discapacidad", "comando": "IBP-EMLA/LPSP", "variantes": ["IEPJ-EMLA/LPSP"], "explicacion": "En discapacidad, ON HOLD es el ultimo paso; el cliente envia CONADIS y Back Office finaliza el pago. Informar emision con PCC.", "confianza": "verbatim" },
    { "n": 15, "sistema": "amadeus", "proceso": "Incluir titular de tarjeta", "comando": null, "plantilla": "RMCSY/{nombreTitular}:{apellidoTitular}", "explicacion": "Nuevo Cyber.", "confianza": "verbatim" },
    { "n": 16, "sistema": "amadeus", "proceso": "Incluir gasto de gestion", "comando": null, "plantilla": "TTO/ST01/CSF/F{gastoGestion}", "explicacion": "Con varios TST agregar /T{numeroTST}. Guardar con ER.", "confianza": "verbatim" },
    { "n": 17, "sistema": "iberianet", "proceso": "Tomar datos de tarjeta PCI Pal o Travel Pay", "comando": null, "explicacion": "El manual remite a las formas de pago PCI Pal o Travel Pay, pero no aporta comando de terminal.", "confianza": "hueco", "nota": "No hay comando documentado para este paso. Confirma el procedimiento de pago antes de continuar." },
    { "n": 18, "sistema": "amadeus", "proceso": "Agregar forma de pago", "comando": null, "plantilla": "FP {tokenPCIoTravelPay}", "explicacion": "FP TOKEN desde PCI o Travel Pay.", "confianza": "verbatim" },
