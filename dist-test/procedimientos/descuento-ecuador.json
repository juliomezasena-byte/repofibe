  "advertencias": [
    { "nivel": "critico", "texto": "Este manual SOLO aplica para reservas con DESCUENTO PAIS. Las reservas sin descuento siguen RESERVAS GENERALES.", "confianza": "verbatim" },
    { "nivel": "critico", "texto": "Solo aplica a reservas cotizadas en USD del mercado de Ecuador UIO001.", "confianza": "verbatim" },
    { "nivel": "critico", "texto": "Los descuentos son unicamente validos para residentes ecuatorianos y no son acumulables con otros descuentos.", "confianza": "verbatim" },
    { "nivel": "alto", "texto": "Discapacidad: 50% con carnet CONADIS. Jovenes de 12 a 24 anos: 25%. Adulto mayor ecuatoriano de 65 anos o mas: 50%.", "confianza": "verbatim" },
    { "nivel": "alto", "texto": "Si aplica discapacidad, solo se puede generar reserva ON HOLD; el pasajero debe enviar el documento CONADIS a VENTADIRECTALATAM@IBERIA.COM y Back Office finaliza el pago.", "confianza": "verbatim" },
    { "nivel": "alto", "texto": "La edad, residencia y discapacidad no se deben suponer: deben validarse con los datos y documentos del pasajero.", "confianza": "derivado" }
