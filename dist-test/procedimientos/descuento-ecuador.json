  "fuente": { "documento": "Iberianet Lite - #3065 3. DESCUENTOS ECUADOR", "tipo": "manual-oficial-interno", "recibido": "2026-08-12", "confianzaGlobal": "verbatim", "nota": "Transcrito desde el texto aportado por el usuario; comandos conservados desde la columna TRANSACCION." },
  "pasos": [
    { "n": 1, "sistema": "amadeus", "proceso": "Buscar fechas de vuelo - solo ida", "comando": null, "plantilla": "AN {fecha} {origen}{destino}", "explicacion": "AN FECHA ORGDES. Ejemplo: 11MAR y MADBOG.", "confianza": "verbatim" },
    { "n": 1.1, "sistema": "amadeus", "proceso": "Buscar fechas de vuelo - ida y vuelta", "comando": null, "plantilla": "AN {fechaIda} {origen}{destino} * {fechaVuelta}", "explicacion": "AN FECHA1 ORGDES * FECHA2.", "confianza": "verbatim" },
    { "n": 1.2, "sistema": "amadeus", "proceso": "Buscar todas las clases ofertadas", "comando": null, "plantilla": "SN {fecha} {origen}{destino}", "explicacion": "SN FECHA ORG DES.", "confianza": "verbatim" },
    { "n": 1.3, "sistema": "amadeus", "proceso": "Cambiar rapidamente la fecha", "comando": "MY", "variantes": ["MN"], "explicacion": "MY dia anterior; MN dia siguiente.", "confianza": "verbatim", "opcional": true },
    { "n": 2, "sistema": "amadeus", "proceso": "Seleccionar plazas - solo un vuelo", "comando": null, "plantilla": "SS {plazas} {clase} {lineaVuelo}", "explicacion": "SS PLAZAS CLASE LINEA DE VUELO. El INF no ocupa plaza.", "confianza": "verbatim" },
    { "n": 2.1, "sistema": "amadeus", "proceso": "Seleccionar plazas - ida y vuelta", "comando": null, "plantilla": "SS {plazas} {claseIda} {lineaIda} * {claseVuelta} {lineaVuelta}", "explicacion": "SS PLAZAS CLASE IDA LINEA DE VUELO * CLASE REGRESO LINEA DE VUELO.", "confianza": "verbatim" },
    { "n": 2.2, "sistema": "amadeus", "proceso": "Seleccionar plazas - clases diferentes por vuelo", "comando": null, "plantilla": "SS {plazas} {claseVuelo1} {claseVuelo2} {lineaVuelo}", "explicacion": "Las clases corresponden a cada vuelo.", "confianza": "verbatim" },
    { "n": 3, "sistema": "amadeus", "proceso": "Cotizar descuento por discapacidad", "comando": null, "plantilla": "FXX/FF-{tarifa}/RDIS", "explicacion": "RDIS aplica el descuento DIS.", "confianza": "verbatim" },
    { "n": 3.1, "sistema": "amadeus", "proceso": "Cotizar descuento joven de 12 a 24 anos", "comando": null, "plantilla": "FXX/FF-{tarifa}/RZZ", "explicacion": "RZZ aplica el descuento ZZ.", "confianza": "verbatim" },
    { "n": 3.2, "sistema": "amadeus", "proceso": "Cotizar descuento adulto mayor de 65 anos", "comando": null, "plantilla": "FXX/FF-{tarifa}/RCD", "explicacion": "RCD aplica el descuento CD.", "confianza": "verbatim" },
    { "n": 3.3, "sistema": "amadeus", "proceso": "Recotizar si aparece NO FARES/RBD/CARRIER/PASSENGER TYPE", "comando": null, "plantilla": "FXR/FF-{tarifa}/{codigoDescuento}", "explicacion": "Cambia las clases y reemplaza FXX por FXR.", "confianza": "verbatim" },
    { "n": 4, "sistema": "amadeus", "proceso": "Documentar valores informados al cliente", "comando": null, "plantilla": "RM{fechaRM}PAX AVDO VALOR TKT {detalleValores} USD//{iniciales}", "explicacion": "Documenta valores para CHD, ADT e INF.", "confianza": "verbatim" },
    { "n": 5, "sistema": "amadeus", "proceso": "Buscar condiciones de tarifa", "comando": null, "plantilla": "FQN {lineaTarifa} * PE", "explicacion": "PE es constante.", "confianza": "verbatim" },
    { "n": 6, "sistema": "amadeus", "proceso": "Documentar condiciones indicadas al cliente", "comando": null, "plantilla": "RM{fechaRM}PAX AVDO {condicionesTarifa} //{iniciales}", "explicacion": "Documenta las condiciones comunicadas.", "confianza": "verbatim" },
    { "n": 7, "sistema": "amadeus", "proceso": "Agregar nombres - adulto", "comando": null, "plantilla": "NM1 {apellidoAdulto}/{nombreAdulto}", "explicacion": "NM1 APELLIDO/NOMBRE.", "confianza": "verbatim" },
    { "n": 7.1, "sistema": "amadeus", "proceso": "Agregar nombres - child", "comando": null, "plantilla": "NM1 {apellidoChild}/{nombreChild}(CHD/{fechaNacimientoChild})", "explicacion": "NM1 APELLIDO/NOMBRE (CHD/FECHA DE NACIMIENTO).", "confianza": "verbatim" },
    { "n": 7.2, "sistema": "amadeus", "proceso": "Agregar nombres - adulto con infante", "comando": null, "plantilla": "NM1 {apellidoAdulto}/{nombreAdulto} (INF{apellidoInfante}/{nombreInfante}/{fechaNacimientoInfante})", "explicacion": "El INF va asociado al adulto y no lleva barra despues de INF.", "confianza": "verbatim" },
    { "n": 7.3, "sistema": "amadeus", "proceso": "Ingresar Iberia Plus", "comando": null, "plantilla": "FFA{aerolineaFF}-{numeroViajeroFrecuente}", "explicacion": "Es opcional.", "confianza": "verbatim", "opcional": true },
    { "n": 8, "sistema": "amadeus", "proceso": "Incluir correo", "comando": null, "plantilla": "APE- {email}", "variantes": ["SR CTCE- {emailSSR}"], "explicacion": "En CTCE se reemplaza @ por //. ", "confianza": "verbatim" },
    { "n": 8.1, "sistema": "amadeus", "proceso": "Incluir telefono", "comando": null, "plantilla": "AP+ {telefono}", "variantes": ["SR CTCM- {telefono}"], "explicacion": "AP+ y SSR CTCM.", "confianza": "verbatim" },
